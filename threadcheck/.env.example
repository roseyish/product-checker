# ---------- Model provider (any OpenAI-compatible endpoint) ----------
LLM_PROVIDER=openai          # openai | mock

# Google Gemini (recommended free tier). Get a key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=AIza...
LLM_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768                # gemini-embedding-001 supports 768 / 1536 / 3072

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536

# Ollama (local, free)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768

# ---------- Storage ----------
VECTOR_STORE=pgvector        # pgvector | memory
DATABASE_URL=postgresql://threadcheck:threadcheck@localhost:5432/threadcheck

# ---------- Retrieval ----------
TOP_K=8
RERANK_TOP_N=4
